PORT=5000
NODE_ENV=development

# MongoDB connection (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=ekotro

# Comma separated list of allowed browser origins (your Next.js client)
CLIENT_URL=http://localhost:3000

# Base URL of the Next.js app that runs BetterAuth.
# Used to fetch the JWKS (<AUTH_URL>/api/auth/jwks) and as the JWT issuer/audience.
# Must be EXACTLY the same value as BETTER_AUTH_URL in the client.
AUTH_URL=http://localhost:3000
